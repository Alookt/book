{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "files": [
    "src/main.ts",
    "src/main.server.ts",
    "src/server.ts",
    "src/app/app.config.ts",
    "src/app/app.config.server.ts",
    "src/app/app.ts"
  ],
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
